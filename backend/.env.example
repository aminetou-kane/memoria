# Copier ce fichier en ".env" (dans le dossier backend) puis adapter si besoin.
# Valeurs par défaut de WAMP : utilisateur root, sans mot de passe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centre_doc

# Nom affiché dans l'application (page de connexion, en-tête, onglet du navigateur)
APP_NOM=Mémoria
APP_SOUS_TITRE=Gestion et recherche des thèses et mémoires

# Compte administrateur créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@ugb.edu.sn
ADMIN_PASSWORD=Admin123!

# Secret des sessions (32 caractères minimum) : à changer
JWT_SECRET=change-me-en-production-secret-de-32-caracteres-minimum
