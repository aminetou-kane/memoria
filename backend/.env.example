# Copier ce fichier en ".env" (dans le dossier backend) puis adapter si besoin.
# Valeurs par défaut de WAMP : utilisateur root, sans mot de passe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centre_doc

# Nom affiché dans l'application (page de connexion, en-tête, onglet du navigateur)
APP_NOM=Mémoria
APP_SOUS_TITRE=Gestion et recherche des thèses et mémoires

# Compte administrateur créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@ugb.edu.sn
ADMIN_PASSWORD=Admin123!

# Secret des sessions (32 caractères minimum) : à changer
JWT_SECRET=change-me-en-production-secret-de-32-caracteres-minimum

# --- Déploiement en ligne (démonstration pour recruteurs) ---
# DEMO_MODE=true : affiche des comptes de test sur la page de connexion, crée les tables et les données fictives au démarrage.
# Ne jamais l'activer avec de vraies données : les mots de passe de test deviennent publics.
DEMO_MODE=false
# Base MySQL hébergée (TiDB Cloud, Aiven...) : connexion chiffrée
DB_SSL=false
# Origines autorisées pour CORS (inutile si l'interface est servie par l'application elle-même)
CORS_ORIGINS=http://localhost:4200
